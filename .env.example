# Copy to .env and fill in. Only OPENROUTER_API_KEY is required; add a supplier
# key for each supplier you want to source from (JLCPCB/LCSC needs no key).

# LLM provider. If OPENROUTER_API_KEY is set, traces uses OpenRouter. If it is
# blank/absent — OR the key is broken/unreachable — traces automatically falls
# back to the local Ollama model below (no key, nothing leaves your machine).
OPENROUTER_API_KEY=
# Optional: OpenRouter model (default: google/gemini-3.1-flash-lite)
# DEFAULT_MODEL=google/gemini-3.1-flash-lite

# Local model (Ollama). This is the default when OPENROUTER_API_KEY is blank and
# the fallback whenever an OpenRouter call fails. `./install.sh` pulls it for you
# (when running fully local). Must be tool-capable for sourcing.
OLLAMA_MODEL=gemma4
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Mouser — https://www.mouser.com/api-hub/
MOUSER_API_KEY=

# Digi-Key — https://developer.digikey.com/ (production keys)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Local server (used by the KiCad extension). Defaults shown.
# TRACES_HOST=127.0.0.1
# TRACES_PORT=8000
